#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };

        context {
            bindings = <&kp K_CONTEXT_MENU>;
            key-positions = <49 48>;
        };
    };

    behaviors {
        esc_tab: esc_tab {
            compatible = "zmk,behavior-mod-morph";
            label = "ESC_TAB";
            bindings = <&kp ESCAPE>, <&kp TAB>;

            #binding-cells = <0>;
            mods = <(MOD_LALT|MOD_LGUI)>;
            keep-mods = <(MOD_LALT|MOD_LGUI)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&esc_tab      &kp Q  &kp W         &kp E         &kp R                  &kp T        &kp Y    &kp U                       &kp I        &kp O           &kp P           &kp BSPC
&kp CAPSLOCK  &kp A  &kp S         &kp D         &kp F                  &kp G        &kp H    &kp J                       &kp K        &kp L           &kp MINUS       &kp ENTER
&kp LSHFT     &none  &kp Z         &kp X         &kp C                  &kp V        &kp B    &kp DELETE                  &kp N        &kp M           &kp COMMA       &kp DOT          &kp UP_ARROW  &kp RIGHT_SHIFT
&kp LCTRL     &none  &kp LEFT_WIN  &kp LEFT_ALT  &lt 3 INTERNATIONAL_5  &lt 2 SPACE  &kp TAB  &lt 2 INT_KATAKANAHIRAGANA  &lt 3 RCTRL  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &kp LC(LG(LEFT))  &kp LG(LC(RIGHT))  &trans       &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB1  &mkp MB2          &mkp RCLK          &kp LG(TAB)  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans            &trans             &trans       &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans            &trans             &trans       &trans
            >;
        };

        layer_2 {
            bindings = <
&kp ESCAPE  &kp N1    &kp N2            &kp N3    &kp N4      &kp N5     &kp N6     &kp N7         &kp N8     &kp N9          &kp N0            &kp INT_YEN
&trans      &kp EXCL  &kp LEFT_BRACKET  &kp HASH  &kp DOLLAR  &kp PRCNT  &kp CARET  &kp AMPERSAND  &kp ASTRK  &kp SEMICOLON   &kp SINGLE_QUOTE  &kp SLASH
&trans      &trans    &trans            &trans    &trans      &trans     &trans     &trans         &kp TILDE  &kp LEFT_BRACE  &kp RIGHT_BRACE   &kp LEFT_BRACKET  &kp QUESTION  &mt (RC(RIGHT_SHIFT)) LS(INT_RO)
&trans      &trans    &trans            &trans    &trans      &trans     &trans     &trans         &trans     &trans          &trans            &kp RCTRL
            >;
        };

        layer_3 {
            bindings = <
&trans  &kp F1        &kp F2        &kp F3        &kp F4        &kp F5      &trans          &kp FSLH  &kp ASTRK  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9
&trans  &kp F6        &kp F7        &kp F8        &kp F9        &kp F10     &kp HOME        &trans    &kp MINUS  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6
&trans  &kp F11       &kp F12       &out OUT_USB  &out OUT_BLE  &bt BT_NXT  &bt BT_CLR_ALL  &trans    &kp END    &trans           &kp GRAVE        &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans      &trans          &trans    &trans     &kp KP_NUMBER_0  &kp DOT          &kp EQUAL
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
&kp ESC  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5   &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F12
&trans   &kp F6   &kp F7   &kp F8  &kp F9  &kp F10  &trans  &trans  &trans  &trans  &trans   &trans
&trans   &kp F11  &kp F12  &trans  &trans  &trans   &trans  &trans  &trans  &trans  &trans   &trans   &trans  &trans
&trans   &trans   &trans   &trans  &trans  &trans   &trans  &trans  &trans  &trans  &trans   &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
